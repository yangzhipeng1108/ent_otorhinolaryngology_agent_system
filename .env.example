# 三甲医院耳鼻喉科问诊Agent系统 - 环境变量配置示例
# 复制此文件为 .env 并根据实际环境修改配置

# 应用基础配置
APP_NAME=三甲医院耳鼻喉科问诊Agent系统
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# 服务配置
HOST=0.0.0.0
PORT=8000

# 数据库配置
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ent_agent_db
DATABASE_USER=ent_user
DATABASE_PASSWORD=ent_password
# 或者直接使用完整URL
# DATABASE_URL=postgresql://ent_user:ent_password@localhost:5432/ent_agent_db

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# 或者直接使用完整URL
# REDIS_URL=redis://localhost:6379/0

# JWT配置
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS配置
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:3000","http://127.0.0.1:8080"]

# 可信主机配置
ALLOWED_HOSTS=["localhost","127.0.0.1","0.0.0.0"]

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# 文件上传配置
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# AI模型配置
AI_MODEL_PATH=models/
AI_MODEL_TIMEOUT=30

# 外部系统集成配置
HIS_SYSTEM_URL=
LIS_SYSTEM_URL=
EMR_SYSTEM_URL=

# 监控配置
ENABLE_METRICS=true
METRICS_PORT=9090
